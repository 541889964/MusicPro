<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈渐变描边 -->
    <item>
        <shape>
            <corners android:radius="1000dp"/>
            <gradient android:angle="0"
                android:startColor="#FF9B6BFF"
                android:centerColor="#FFFF6B9D"
                android:endColor="#FF9B6BFF"/>
        </shape>
    </item>
    <!-- 内层深色实心 -->
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape>
            <corners android:radius="1000dp"/>
            <gradient android:angle="90"
                android:startColor="#F5100D24"
                android:endColor="#F00A0818"/>
        </shape>
    </item>
</layer-list>

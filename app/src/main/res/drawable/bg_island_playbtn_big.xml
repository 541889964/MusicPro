<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外光晕 -->
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp"
                android:startColor="#AAFF6B9D" android:centerColor="#559B6BFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- 主按钮 -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:angle="45"
                android:startColor="#FFFFFF" android:endColor="#E0D5FF"/>
        </shape>
    </item>
</layer-list>

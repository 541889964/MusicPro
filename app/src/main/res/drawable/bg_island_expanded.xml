<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="36dp"/>
            <gradient android:angle="135"
                android:startColor="#88FF6B9D"
                android:centerColor="#559B6BFF"
                android:endColor="#88FF6B9D"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="34dp"/>
            <gradient android:type="linear" android:angle="135"
                android:startColor="#F0221840"
                android:centerColor="#F00D0B1F"
                android:endColor="#F01A0F2E"/>
        </shape>
    </item>
</layer-list>

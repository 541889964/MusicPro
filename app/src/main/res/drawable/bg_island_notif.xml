<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp"/>
            <gradient android:type="linear" android:angle="0"
                android:startColor="#FF6B9D" android:endColor="#9B6BFF"/>
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape>
            <corners android:radius="18.5dp"/>
            <solid android:color="#F01A0F2E"/>
        </shape>
    </item>
</layer-list>

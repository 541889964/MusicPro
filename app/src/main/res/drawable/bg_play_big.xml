<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#FFFFFF" android:endColor="#E8DFFF"/>
            <stroke android:width="2dp" android:color="#55FF6B9D"/>
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp"
                android:startColor="#FFFFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>

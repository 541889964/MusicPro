<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0B1F">
    <LinearLayout android:id="@+id/playerCard"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/btnClose"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="✕" android:textSize="22sp" android:textColor="#FFFFFF"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <ImageView android:id="@+id/ivCover"
            android:layout_width="200dp" android:layout_height="200dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="20dp"
            android:src="@mipmap/ic_launcher" android:scaleType="centerCrop"/>
        <TextView android:id="@+id/tvPlayerTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center" android:text="歌曲名"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
            android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/tvPlayerArtist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:text=""
            android:textColor="#B8A8E8" android:textSize="13sp" android:singleLine="true"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="20dp">
            <ScrollView android:id="@+id/lyricsScroll"
                android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:id="@+id/lyricsContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>
            <TextView android:id="@+id/tvLyricsEmpty"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="♪ 暂无歌词"
                android:textColor="#88FFFFFF" android:textSize="13sp"/>
        </FrameLayout>
        <SeekBar android:id="@+id/seekBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:progressTint="#FF6B9D" android:thumbTint="#FF6B9D"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvCurrent"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="0:00"
                android:textColor="#B8A8E8" android:textSize="11sp"/>
            <TextView android:id="@+id/tvTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="#B8A8E8" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" android:gravity="center">
            <TextView android:id="@+id/btnPrev"
                android:layout_width="60dp" android:layout_height="60dp"
                android:text="⏮" android:textSize="28sp" android:textColor="#FFFFFF"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnPlay"
                android:layout_width="80dp" android:layout_height="80dp"
                android:layout_marginHorizontal="20dp"
                android:text="▶" android:textSize="30sp" android:textColor="#000000"
                android:gravity="center" android:background="@drawable/bg_island_playbtn_big"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnNext"
                android:layout_width="60dp" android:layout_height="60dp"
                android:text="⏭" android:textSize="28sp" android:textColor="#FFFFFF"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0B1F"
    android:padding="20dp"
    android:gravity="center">

    <ImageButton android:id="@+id/btnClose"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="start"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"/>

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    <ImageView android:id="@+id/ivCover"
        android:layout_width="240dp" android:layout_height="240dp"
        android:scaleType="centerCrop"/>

    <TextView android:id="@+id/tvTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="30dp" android:gravity="center"
        android:text="歌曲名" android:textColor="#FFFFFF"
        android:textSize="20sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="end"/>

    <TextView android:id="@+id/tvArtist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center"
        android:text="歌手" android:textColor="#88FFFFFF" android:textSize="14sp"/>

    <SeekBar android:id="@+id/seek"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:progressTint="#FF6B9D"
        android:thumbTint="#FF6B9D"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvCur"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="0:00"
            android:textColor="#88FFFFFF" android:textSize="11sp"/>
        <TextView android:id="@+id/tvTot"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0:00" android:textColor="#88FFFFFF" android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp"
        android:gravity="center">

        <ImageButton android:id="@+id/btnPrev"
            android:layout_width="60dp" android:layout_height="60dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"/>

        <ImageButton android:id="@+id/btnPlay"
            android:layout_width="80dp" android:layout_height="80dp"
            android:layout_marginLeft="30dp" android:layout_marginRight="30dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/bg_play_big"
            android:tint="#000000"
            android:padding="20dp"/>

        <ImageButton android:id="@+id/btnNext"
            android:layout_width="60dp" android:layout_height="60dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"/>
    </LinearLayout>

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>

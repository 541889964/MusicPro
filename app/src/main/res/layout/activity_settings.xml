<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0B1F">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部栏 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp"
                android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnBack"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="12dp"
                    android:text="设置" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- 灵动岛 -->
            <LinearLayout android:id="@+id/itemIsland"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/theme_option_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📊" android:textSize="22sp" android:layout_marginRight="16dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="灵动岛设置" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="尺寸 · 帧率 · 动画"
                        android:textColor="#B8A8E8" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <!-- 锁屏 -->
            <LinearLayout android:id="@+id/itemLock"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/theme_option_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔒" android:textSize="22sp" android:layout_marginRight="16dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="锁屏播放" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="锁屏界面显示播放控制"
                        android:textColor="#B8A8E8" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <!-- 换肤 -->
            <LinearLayout android:id="@+id/itemTheme"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/theme_option_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎨" android:textSize="22sp" android:layout_marginRight="16dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="换肤中心" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="更换背景 · 自动轮播"
                        android:textColor="#B8A8E8" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <!-- 画廊 -->
            <LinearLayout android:id="@+id/itemGallery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/theme_option_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🖼️" android:textSize="22sp" android:layout_marginRight="16dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="素材画廊" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="浏览所有素材 · 一键换肤"
                        android:textColor="#B8A8E8" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/itemTestNotif"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/theme_option_bg"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔔" android:textSize="22sp" android:layout_marginRight="16dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="通知测试" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="点一下发一条测试通知，看灵动岛反应"
                        android:textColor="#B8A8E8" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="60dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

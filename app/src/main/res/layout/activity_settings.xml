<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0B1F"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="←"
            android:textSize="22sp" android:textColor="#FFFFFF"
            android:clickable="true" android:focusable="true"/>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="16dp"
            android:text="设置" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="灵动岛宽度"
        android:textColor="#FFFFFF" android:textSize="15sp"/>
    <TextView android:id="@+id/tvCw"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="55%" android:textColor="#FF6B9D" android:textSize="13sp"/>
    <SeekBar android:id="@+id/sbCw"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:max="80" android:progressTint="#FF6B9D"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="灵动岛高度"
        android:textColor="#FFFFFF" android:textSize="15sp"/>
    <TextView android:id="@+id/tvCh"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="54dp" android:textColor="#FF6B9D" android:textSize="13sp"/>
    <SeekBar android:id="@+id/sbCh"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:max="90" android:progressTint="#FF6B9D"/>

    <TextView android:id="@+id/btnTestNotif"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="30dp" android:padding="18dp"
        android:gravity="center"
        android:text="发送测试通知"
        android:textColor="#FFFFFF" android:textSize="15sp"
        android:background="@drawable/bg_glass_card"
        android:clickable="true" android:focusable="true"/>
</LinearLayout>

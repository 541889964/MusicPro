<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0B1F">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/btnBack"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:text="←" android:textSize="22sp" android:textColor="#FFFFFF"
                    android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="12dp"
                    android:text="设置" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnGallery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginTop="20dp" android:background="@drawable/card_bg"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="素材画廊"
                    android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnOverlay"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginTop="10dp" android:background="@drawable/card_bg"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="悬浮窗权限"
                    android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnNotif"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginTop="10dp" android:background="@drawable/card_bg"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="通知监听权限"
                    android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnBattery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginTop="10dp" android:background="@drawable/card_bg"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="电池优化白名单"
                    android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAbout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp"
                android:layout_marginTop="10dp" android:background="@drawable/card_bg"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="关于"
                    android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#8E8E93" android:textSize="22sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

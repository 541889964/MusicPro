<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 折叠态 -->
    <LinearLayout android:id="@+id/collapsedBox"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_island"
        android:paddingLeft="8dp" android:paddingRight="8dp"
        android:gravity="center_vertical">

        <ImageView android:id="@+id/imgCover"
            android:layout_width="38dp" android:layout_height="38dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_island_cover"/>

        <TextView android:id="@+id/txtTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:text="未播放" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold"
            android:singleLine="true" android:ellipsize="end"
            android:gravity="center_vertical"/>

        <com.music.app.widget.WaveformView
            android:id="@+id/wave"
            android:layout_width="24dp" android:layout_height="18dp"
            android:layout_marginRight="6dp"/>

        <TextView android:id="@+id/btnPlay"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="▶" android:textSize="18sp"
            android:textColor="#FFFFFF" android:gravity="center"
            android:background="@drawable/bg_island_playbtn"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- 展开态 -->
    <LinearLayout android:id="@+id/expandedBox"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_island_expanded"
        android:padding="14dp" android:visibility="gone">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/imgCoverBig"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_island_cover"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginLeft="10dp">
                <TextView android:id="@+id/txtTitleBig"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="未播放" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textStyle="bold"
                    android:singleLine="true" android:ellipsize="end"/>
                <TextView android:id="@+id/txtArtistBig"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text=""
                    android:textColor="#8E8E93" android:textSize="11sp"
                    android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/btnClose"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="✕" android:textSize="16sp"
                android:textColor="#8E8E93" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- 五行歌词 -->
        <TextView android:id="@+id/lyric1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text=""
            android:textColor="#33FFFFFF" android:textSize="10sp"
            android:gravity="center" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/lyric2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text=""
            android:textColor="#66FFFFFF" android:textSize="12sp"
            android:gravity="center" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/lyric3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text=""
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:gravity="center" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/lyric4"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text=""
            android:textColor="#66FFFFFF" android:textSize="12sp"
            android:gravity="center" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/lyric5"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text=""
            android:textColor="#33FFFFFF" android:textSize="10sp"
            android:gravity="center" android:singleLine="true" android:ellipsize="end"/>

        <!-- 进度条 -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="6dp" android:gravity="center_vertical">
            <TextView android:id="@+id/txtTimeCur"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="#8E8E93"
                android:textSize="10sp" android:minWidth="30dp"/>
            <SeekBar android:id="@+id/seek"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginRight="6dp"
                android:maxHeight="3dp" android:minHeight="3dp" android:max="1000"
                android:progressTint="#FFFFFF" android:progressBackgroundTint="#33FFFFFF"
                android:thumbTint="#FFFFFF"/>
            <TextView android:id="@+id/txtTimeTot"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="#8E8E93"
                android:textSize="10sp" android:minWidth="30dp" android:gravity="right"/>
        </LinearLayout>

        <!-- 控制 -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="6dp" android:gravity="center">
            <TextView android:id="@+id/btnMode"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="🔁" android:textSize="18sp"
                android:textColor="#FFFFFF" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnPrev"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:text="◀◀" android:textSize="16sp"
                android:textColor="#FFFFFF" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnPlayBig"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
                android:text="▶" android:textSize="22sp"
                android:textColor="#000000" android:gravity="center"
                android:background="@drawable/bg_island_playbtn_big"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnNext"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginRight="12dp"
                android:text="▶▶" android:textSize="16sp"
                android:textColor="#FFFFFF" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnFav"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="♡" android:textSize="20sp"
                android:textColor="#FFFFFF" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

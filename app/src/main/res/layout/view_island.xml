<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:id="@+id/islandCollapsed"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/island_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:gravity="center_vertical"
        android:clickable="true" android:focusable="true">

        <ImageView android:id="@+id/islandCover"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            android:background="@drawable/island_cover_frame"/>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginLeft="10dp">
            <TextView android:id="@+id/islandTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="♪ 正在播放" android:textColor="#FFFFFF"
                android:textSize="12sp" android:textStyle="bold"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/islandArtist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MUSIC·Pro" android:textColor="#B8A8E8"
                android:textSize="10sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>

        <ImageButton android:id="@+id/islandPlay"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FF6B9D" android:padding="8dp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/islandExpanded"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/island_bg_expanded"
        android:padding="12dp" android:visibility="gone"
        android:clickable="true" android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/islandExpCover"
                android:layout_width="52dp" android:layout_height="52dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/island_cover_frame"/>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginLeft="12dp">
                <TextView android:id="@+id/islandExpTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="正在播放" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold"
                    android:singleLine="true" android:ellipsize="end"/>
                <TextView android:id="@+id/islandExpArtist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="MUSIC·Pro" android:textColor="#B8A8E8"
                    android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
            </LinearLayout>
            <ImageButton android:id="@+id/islandClose"
                android:layout_width="36dp" android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:padding="8dp"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <SeekBar android:id="@+id/islandProgress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="3dp" android:minHeight="3dp"
            android:max="1000"
            android:progressTint="#FF6B9D"
            android:progressBackgroundTint="#44FFFFFF"
            android:thumbTint="#FF6B9D"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView android:id="@+id/islandCurrent"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="0:00"
                android:textColor="#B8A8E8" android:textSize="10sp"/>
            <TextView android:id="@+id/islandTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="#B8A8E8" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp"
            android:gravity="center">
            <ImageButton android:id="@+id/islandPrev"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:padding="12dp"
                android:clickable="true" android:focusable="true"/>
            <ImageButton android:id="@+id/islandPlayExpand"
                android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginLeft="24dp" android:layout_marginRight="24dp"
                android:src="@android:drawable/ic_media_pause"
                android:background="@drawable/bg_play_btn"
                android:tint="#FFFFFF" android:padding="14dp"
                android:clickable="true" android:focusable="true"/>
            <ImageButton android:id="@+id/islandNext"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:padding="12dp"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

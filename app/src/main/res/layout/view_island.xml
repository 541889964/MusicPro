<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout android:id="@+id/islandCollapsed"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/island_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:gravity="center_vertical"
        android:clickable="true" android:focusable="true">
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/island_glow"/>
            <ImageView android:id="@+id/islandCover"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/island_cover_frame"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="10dp">
            <TextView android:id="@+id/islandTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="♪ 正在播放" android:textColor="#FFFFFF"
                android:textSize="12sp" android:textStyle="bold"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/islandArtist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MUSIC·Pro" android:textColor="#B8A8E8"
                android:textSize="10sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <ImageButton android:id="@+id/islandPlay"
            android:layout_width="34dp" android:layout_height="34dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FF6B9D" android:padding="6dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/islandExpanded"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/island_bg_expanded"
        android:padding="12dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/island_glow"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="centerCrop"
                    android:background="@drawable/island_cover_frame"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="12dp">
                <TextView android:id="@+id/islandExpTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="正在播放" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/islandExpArtist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="MUSIC·Pro" android:textColor="#B8A8E8" android:textSize="11sp"/>
            </LinearLayout>
            <ImageButton android:id="@+id/islandClose"
                android:layout_width="30dp" android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#88FFFFFF" android:padding="6dp"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/islandProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_marginTop="10dp" android:max="1000" android:progress="0"
            android:progressTint="#FF6B9D" android:progressBackgroundTint="#44FFFFFF"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView android:id="@+id/islandCurrent"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="0:00"
                android:textColor="#B8A8E8" android:textSize="10sp"/>
            <TextView android:id="@+id/islandTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="#B8A8E8" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="center">
            <ImageButton android:id="@+id/islandPrev"
                android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:padding="8dp"/>
            <ImageButton android:id="@+id/islandNext"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginLeft="30dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

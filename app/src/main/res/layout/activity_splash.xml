<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0B1F">
    <ImageView android:layout_width="100dp" android:layout_height="100dp"
        android:src="@mipmap/ic_launcher"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="拾音" android:textColor="#FFFFFF"
        android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="让每一个音符都动起来" android:textColor="#B8A8E8"
        android:textSize="13sp"/>
</LinearLayout>

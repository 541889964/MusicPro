<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dark">

    <View android:id="@+id/glow"
        android:layout_width="500dp" android:layout_height="500dp"
        android:layout_gravity="center"
        android:background="@drawable/glow_radial"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:gravity="center">

        <ImageView android:id="@+id/logo"
            android:layout_width="120dp" android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"/>

        <TextView android:id="@+id/brand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="拾音"
            android:textColor="#FFFFFF" android:textSize="42sp"
            android:textStyle="bold" android:letterSpacing="0.25"/>
    </LinearLayout>

    <TextView android:id="@+id/tip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:text="正在准备…"
        android:textColor="#99FFFFFF" android:textSize="13sp"/>
</FrameLayout>

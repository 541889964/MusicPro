<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0B1F">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/btnBack"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:text="←" android:textSize="22sp" android:textColor="#FFFFFF"
                    android:gravity="center" android:clickable="true" android:focusable="true"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="12dp"
                    android:text="灵动岛设置" android:textColor="#FFFFFF"
                    android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginHorizontal="16dp"
                android:padding="14dp" android:background="@drawable/bg_theme_option">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="折叠宽（%）" android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/tvCW" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="55%"
                    android:textColor="#B8A8E8" android:textSize="11sp"/>
                <SeekBar android:id="@+id/sbCW" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:progressTint="#FF6B9D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="折叠高（dp）"
                    android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/tvCH" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="54dp"
                    android:textColor="#B8A8E8" android:textSize="11sp"/>
                <SeekBar android:id="@+id/sbCH" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:progressTint="#FF6B9D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="展开宽（%）"
                    android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/tvEW" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="90%"
                    android:textColor="#B8A8E8" android:textSize="11sp"/>
                <SeekBar android:id="@+id/sbEW" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:progressTint="#FF6B9D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="展开高（dp）"
                    android:textColor="#FFFFFF" android:textSize="13sp"/>
                <TextView android:id="@+id/tvEH" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="210dp"
                    android:textColor="#B8A8E8" android:textSize="11sp"/>
                <SeekBar android:id="@+id/sbEH" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:progressTint="#FF6B9D"/>
                <TextView android:id="@+id/tvFps" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="当前：60fps" android:textColor="#B8A8E8" android:textSize="11sp"/>
            </LinearLayout>
            <TextView android:id="@+id/btnReset"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp" android:layout_marginTop="20dp"
                android:padding="16dp" android:gravity="center"
                android:text="恢复默认设置"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_theme_option"
                android:clickable="true" android:focusable="true"/>
            <View android:layout_width="match_parent" android:layout_height="60dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
